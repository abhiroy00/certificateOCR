# Share Certificate OCR - example environment file
#
# Copy this file to ".env" and fill in what you need:
#     copy .env.example .env      (Windows)
#     cp   .env.example .env      (macOS / Linux)
#
# The .env file is OPTIONAL. If you are using the desktop app you do not
# need it at all - click the API key chip in the toolbar and paste your key
# there instead. It is stored in the Windows Credential Manager / macOS
# Keychain, which is safer than a text file.
#
# NEVER commit a real .env to git and never put a real key in .env.example.

# --- OpenAI ---------------------------------------------------------------
# Your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# Only for Azure OpenAI or an OpenAI-compatible gateway. Leave blank for
# normal OpenAI.
OPENAI_BASE_URL=

# --- Engine defaults ------------------------------------------------------
# openai = vision model (best accuracy). tesseract = offline, free.
SHARE_OCR_ENGINE=openai

# gpt-4o-mini is the recommended default for bulk runs.
# Others: gpt-4.1-mini, gpt-4.1-nano, gpt-4o, gpt-4.1, o4-mini
SHARE_OCR_MODEL=gpt-4o-mini

# Parallel workers. 8 is fine on a laptop; 32-64 on a server with good
# bandwidth. Too high just gets you rate limited.
SHARE_OCR_WORKERS=8

# --- Paths ----------------------------------------------------------------
# Where the queue database, CSV output, thumbnails and log live.
# Default: C:\Users\<you>\.share_ocr  /  ~/.share_ocr
# Point this at a network share to let several machines work one job.
# SHARE_OCR_HOME=D:\share_ocr_work

# Full path to tesseract.exe, only if you installed it somewhere unusual.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
