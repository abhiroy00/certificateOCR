# ---------------------------------------------------------------- Python --
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Packaging / build output
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST

